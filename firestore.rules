rules_version = '2';

// PMS-IMS — Firestore security rules.
//
// Roles live on users/{uid}.role and only count while users/{uid}.status == "active":
//   enduser     encodes AIRs (own records only); reads the PAR/ICS/RIS issued from them
//   gso         inspects and approves/returns AIRs; issues PAR, ICS, RIS; cancels unposted documents
//   accounting  marks AIR supply receipts and PAR/ICS/RIS as posted in the registry
//   admin       everything above + users (except administrators) and settings
//   superadmin  everything, including administrators
// The hardcoded Super Administrator email below can claim its role once (verified email only);
// it must match SUPERADMIN_EMAILS in public/js/core/catalog.js.
//
// Deploy: firebase deploy --only firestore:rules   (or paste into Firestore → Rules → Publish)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function bootstrapEmail() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['npp@mgocandoniaccounting.org'];
    }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function active() { return signedIn() && exists(userPath()) && get(userPath()).data.status == 'active'; }
    function hasRole(roles) { return active() && get(userPath()).data.role in roles; }
    function isAdmin() { return hasRole(['admin', 'superadmin']); }
    function isSuper() { return hasRole(['superadmin']); }
    function viewer() { return hasRole(['gso', 'accounting', 'admin', 'superadmin']); }
    function encoder() { return hasRole(['enduser', 'admin', 'superadmin']); }
    function issuer() { return hasRole(['gso', 'admin', 'superadmin']); }
    function poster() { return hasRole(['accounting', 'admin', 'superadmin']); }
    // the signed-in user's office ("" if none) — End-Users see the property of their own office
    function myOffice() { return get(userPath()).data.get('office', ''); }
    function sameOffice(office) { return active() && myOffice() != '' && office == myOffice(); }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function validFund(f) { return f in ['GF', 'SEF', 'TF']; }

    // ---------------- users ----------------
    // People brought over from PMS: an administrator invites them by email with a role and office; when they first sign in
    // with that (verified) email, their account is created active with exactly that role and office.
    function myEmail() { return request.auth.token.email.lower(); }
    function invitedAs(data) {
      let inv = get(/databases/$(database)/documents/invites/$(myEmail()));
      return request.auth.token.email_verified == true && exists(/databases/$(database)/documents/invites/$(myEmail()))
        && data.status == 'active' && data.role == inv.data.role && data.office == inv.data.office;
    }
    match /invites/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow create, update: if (isAdmin() && request.resource.data.email == email && request.resource.data.role in ['accounting', 'gso', 'enduser'])
        || (isSuper() && request.resource.data.email == email && request.resource.data.role == 'admin');
      // the invited person marks it used when activating
      allow update: if signedIn() && myEmail() == email && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedUid', 'acceptedAt']) && request.resource.data.acceptedUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      // GSO and Accounting see the directory too (names for "received by" pickers)
      allow read: if signedIn() && (request.auth.uid == uid || viewer());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
        && ((request.resource.data.role == 'enduser' && request.resource.data.status == 'pending')
            || (bootstrapEmail() && request.resource.data.role == 'superadmin' && request.resource.data.status == 'active')
            || invitedAs(request.resource.data));

      allow update: if
        // a pending user corrects their own registration (role and status stay as they are)
        (signedIn() && request.auth.uid == uid && resource.data.status == 'pending'
          && request.resource.data.uid == uid && request.resource.data.email == resource.data.email
          && request.resource.data.role == 'enduser' && request.resource.data.status == 'pending')
        // the designated Super Administrator claims the role
        || (request.auth.uid == uid && bootstrapEmail() && request.resource.data.uid == uid
          && request.resource.data.role == 'superadmin' && request.resource.data.status == 'active')
        // everyone edits their own profile details — not their office, which decides whose property they see
        || (signedIn() && request.auth.uid == uid && onlyChanged(['displayName', 'position', 'contact', 'photoURL', 'updatedAt']))
        // administrators set other people's role and status
        || (isAdmin() && request.auth.uid != uid
          && onlyChanged(['role', 'status', 'note', 'office', 'reviewedBy', 'reviewedAt', 'updatedAt'])
          && request.resource.data.role in ['superadmin', 'admin', 'accounting', 'gso', 'enduser']
          && request.resource.data.status in ['pending', 'active', 'disabled', 'declined']
          && (isSuper() || (!(request.resource.data.role in ['admin', 'superadmin']) && !(resource.data.role in ['admin', 'superadmin']))));

      allow delete: if false;
    }

    // ---------------- settings and numbering ----------------
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // One counter per fund, document type and month: seq only ever goes up by one.
    // A new series starts at the administrator's starting number; after that it only moves forward by one.
    // Administrators may set the next number of a series (Settings → Document numbering).
    match /counters/{key} {
      allow read: if active();
      allow create: if (active() && (request.resource.data.seq == 1
          || (request.resource.data.type is string
            && request.resource.data.seq == get(/databases/$(database)/documents/settings/app).data.get('numbering', {}).get(request.resource.data.type, {}).get('start', 1))))
        || (isAdmin() && request.resource.data.seq is int && request.resource.data.seq >= 0);
      allow update: if (active() && request.resource.data.seq == resource.data.seq + 1)
        || (isAdmin() && request.resource.data.seq is int && request.resource.data.seq >= 0);
      allow delete: if false;
    }

    // Every document number used, per fund and type ("GF_par_2026-10-0001"): claimed once, in the same transaction
    // as the document, so a number — automatic or typed by hand — can never be used twice.
    // Item list: every item already accepted, with its Item No. (stock no.), unit and account — offered when encoding an AIR
    match /items/{id} {
      allow read: if active();
      allow write: if issuer() || isAdmin();
    }

    // Attachments — signed PAR / ICS / RIS, PTR, photos — added by the GSO or Accounting. The file itself is split
    // into chunks under the attachment. End-Users see the attachments of their own office's documents and property.
    match /attachments/{id} {
      allow read: if viewer() || sameOffice(resource.data.office);
      // the GSO and Accounting attach to documents, property and SWAs; an End-User attaches the photo and invoice to
      // an AIR of their own office
      allow create: if request.resource.data.uploadedBy.uid == request.auth.uid
        && request.resource.data.kind in ['file', 'link'] && request.resource.data.size <= 5242880
        && (((issuer() || poster()) && request.resource.data.target.type in ['issuance', 'asset', 'movement', 'swa', 'air'])
          || (encoder() && request.resource.data.target.type == 'air' && sameOffice(request.resource.data.office)));
      allow update: if false;
      allow delete: if issuer() || poster() || (encoder() && resource.data.target.type == 'air' && resource.data.uploadedBy.uid == request.auth.uid);
      match /chunks/{n} {
        allow read: if viewer() || sameOffice(get(/databases/$(database)/documents/attachments/$(id)).data.office);
        allow create: if (issuer() || poster() || encoder()) && request.resource.data.by == request.auth.uid
          && request.resource.data.data is string && request.resource.data.data.size() <= 900000;
        allow update: if false;
        allow delete: if issuer() || poster() || resource.data.by == request.auth.uid;
      }
    }

    match /docNumbers/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.by == request.auth.uid;
      allow update: if false;
      // released when the GSO renumbers a 2026 document: only once the document no longer carries this number
      allow delete: if issuer() && resource.data.type in ['air', 'par', 'ics', 'ris'] && resource.data.path is string
        && getAfter(/databases/$(database)/documents/$(resource.data.path.split('/')[0])/$(resource.data.path.split('/')[1]))
             .data.get(resource.data.type == 'air' ? 'airNo' : 'number', '') != resource.data.number;
    }
    // Documents dated 2026 (the changeover year) may be renumbered by the GSO.
    function in2026(d) { return d.get('date', '') is string && d.get('date', '').matches('2026-.*'); }

    // ---------------- Acceptance and Inspection Reports ----------------
    match /airs/{id} {
      allow read: if viewer() || (active() && resource.data.endUserUid == request.auth.uid)
        // End-Users also see the submitted AIRs of their own office (not a colleague's drafts)
        || (sameOffice(resource.data.office) && resource.data.status in ['submitted', 'returned', 'approved', 'issued']);

      allow create: if encoder()
        && request.resource.data.endUserUid == request.auth.uid
        && validFund(request.resource.data.fund)
        && request.resource.data.lines is list
        && request.resource.data.status in ['draft', 'submitted']
        // the AIR number is given by the GSO when approving, never by the End-User
        && request.resource.data.airNo == ''
        && !request.resource.data.keys().hasAny(['inspection', 'acceptance', 'posting', 'approvedBy', 'approvedAt'])
        // or: supplies on hand imported from IMS as an approved, already-posted beginning-balance AIR
        || (isAdmin() && request.resource.data.imported == true && request.resource.data.status == 'approved'
          && validFund(request.resource.data.fund) && request.resource.data.lines is list);

      allow update: if
        // End-User edits a draft or a returned AIR, or (re)submits it
        (encoder() && resource.data.endUserUid == request.auth.uid
          && resource.data.status in ['draft', 'returned']
          && request.resource.data.status in ['draft', 'submitted']
          && (resource.data.airNo == '' || request.resource.data.fund == resource.data.fund)
          && validFund(request.resource.data.fund)
          && onlyChanged(['fund', 'date', 'office', 'supplier', 'poNo', 'poDate', 'invNo', 'invDate', 'purpose', 'lines', 'total', 'status', 'history', 'updatedAt', 'submittedAt']))
        // GSO inspects: approves (giving the AIR its number; the GSO may correct the items) or returns a submitted AIR
        || (issuer() && resource.data.status == 'submitted'
          && request.resource.data.status in ['approved', 'returned']
          // returned: no number; approved: it has one — the one given now, or the one it already had
          && ((request.resource.data.status == 'returned' && request.resource.data.airNo == resource.data.airNo)
            || (request.resource.data.status == 'approved' && request.resource.data.airNo is string && request.resource.data.airNo.size() > 0
              && (resource.data.airNo == '' || request.resource.data.airNo == resource.data.airNo)))
          && onlyChanged(['airNo', 'lines', 'total', 'inspection', 'acceptance', 'gsoRemarks', 'status', 'approvedBy', 'approvedAt', 'history', 'updatedAt']))
        // GSO issues or cancels documents: issued quantities and the resulting status
        || (issuer() && resource.data.status in ['approved', 'issued']
          && request.resource.data.status in ['approved', 'issued']
          && onlyChanged(['lines', 'status', 'history', 'updatedAt']))
        // GSO renumbers an AIR dated 2026
        || (issuer() && in2026(resource.data) && resource.data.airNo != '' && request.resource.data.airNo is string
          && request.resource.data.airNo.size() > 0 && onlyChanged(['airNo', 'history', 'updatedAt']))
        // Accounting posts / unposts the receipt of supplies
        || (poster() && resource.data.status in ['approved', 'issued']
          && onlyChanged(['posting', 'history', 'updatedAt']));

      allow delete: if (encoder() && resource.data.endUserUid == request.auth.uid && resource.data.status == 'draft')
        || (isAdmin() && resource.data.status in ['draft', 'returned', 'submitted']);
    }

    // ---------------- PAR / ICS / RIS ----------------
    match /issuances/{id} {
      allow read: if viewer() || (active() && resource.data.endUserUid == request.auth.uid) || sameOffice(resource.data.recipient.office);

      // Created only together with (or after) an approved AIR — getAfter sees the same transaction —
      // or by an administrator bringing over the PAR / ICS still pending in PMS (no AIR), unposted.
      allow create: if (isAdmin() && request.resource.data.origin == 'pms' && request.resource.data.airId == null
          && request.resource.data.docType in ['par', 'ics'] && validFund(request.resource.data.fund)
          && request.resource.data.number is string && request.resource.data.number.size() > 0
          && request.resource.data.status == 'issued' && request.resource.data.posting.posted == false)
        || (issuer()
        && request.resource.data.docType in ['par', 'ics', 'ris']
        && validFund(request.resource.data.fund)
        && request.resource.data.number is string && request.resource.data.number.size() > 0
        && request.resource.data.status == 'issued'
        && request.resource.data.posting.posted == false
        && getAfter(/databases/$(database)/documents/airs/$(request.resource.data.airId)).data.status in ['approved', 'issued']
        && getAfter(/databases/$(database)/documents/airs/$(request.resource.data.airId)).data.fund == request.resource.data.fund
        && getAfter(/databases/$(database)/documents/airs/$(request.resource.data.airId)).data.endUserUid == request.resource.data.endUserUid);

      allow update: if
        // GSO cancels a document Accounting has not posted
        (issuer() && resource.data.status == 'issued' && resource.data.posting.posted == false
          && request.resource.data.status == 'cancelled'
          && onlyChanged(['status', 'cancel', 'updatedAt']))
        // Accounting posts / unposts — an RIS only once its AIR is posted (or in the same batch)
        || (poster() && resource.data.status == 'issued' && onlyChanged(['posting', 'updatedAt'])
          && (resource.data.docType != 'ris' || request.resource.data.posting.posted != true
            || getAfter(/databases/$(database)/documents/airs/$(resource.data.airId)).data.get('posting', {}).get('posted', false) == true))
        // GSO renumbers a PAR / ICS / RIS dated 2026, or it follows its AIR's new number
        || (issuer() && in2026(resource.data) && request.resource.data.number is string && request.resource.data.number.size() > 0
          && onlyChanged(['number', 'renumbered', 'updatedAt']))
        || (issuer() && onlyChanged(['airNo', 'updatedAt'])
          && getAfter(/databases/$(database)/documents/airs/$(resource.data.airId)).data.airNo == request.resource.data.airNo);

      allow delete: if false;
    }

    // ---------------- property register ----------------
    // One record per PAR / ICS line (created in the issuance transaction), per import row, or per split.
    match /assets/{id} {
      allow read: if viewer() || (active() && resource.data.custodianUid == request.auth.uid) || sameOffice(resource.data.holder.office);
      // Items come into the register only from a PAR / ICS (created with it, in the same transaction), a split of an
      // existing item (part of a semi-expendable record moved), a completed CIP project, or Data Import — never by hand.
      allow create: if ((issuer() && request.resource.data.source.kind in ['par', 'ics']
            && getAfter(/databases/$(database)/documents/issuances/$(request.resource.data.source.docId)).data.docType == request.resource.data.source.kind)
          || (issuer() && request.resource.data.get('splitFrom', '') is string && request.resource.data.get('splitFrom', '') != ''
            && exists(/databases/$(database)/documents/assets/$(request.resource.data.splitFrom)))
          || (isAdmin() && request.resource.data.source.kind == 'import')
          // Accounting closes a CIP project into a new PPE record, in the same transaction
          || (poster() && request.resource.data.source.kind == 'cip'
            && getAfter(/databases/$(database)/documents/cipProjects/$(request.resource.data.source.docId)).data.status == 'completed'
            && getAfter(/databases/$(database)/documents/cipProjects/$(request.resource.data.source.docId)).data.completed.assetId == id))
        && validFund(request.resource.data.fund)
        && request.resource.data.itemType in ['ppe', 'sx']
        && request.resource.data.cost is number && request.resource.data.cost >= 0
        && request.resource.data.status in ['active', 'returned', 'disposed'];
      allow update: if request.resource.data.status in ['active', 'returned', 'disposed', 'cancelled']
        && request.resource.data.itemType == resource.data.itemType && validFund(request.resource.data.fund) && (
        // GSO: custody, movements, splits, PAR / ICS for register items and descriptions — never the fund, account, source or ledger
        (issuer() && onlyChanged(['holder', 'custodianUid', 'location', 'status', 'condition', 'disposal', 'history', 'updatedAt', 'qty', 'cost', 'unitCost',
          'propertyNo', 'usefulLifeYears', 'residualValue', 'depreciable', 'estimatedLife', 'description', 'specs',
          'articleType', 'remarks', 'dvNo', 'photoUrl', 'docUrl', 'unit', 'special', 'acquisition', 'parIcs']))
        // Accounting: the ledger side — cost corrections, revaluations, adjustments / impairments, reclassification,
        // fund transfer, opening balances, CIP additions and reactivation of a disposed item (status: disposed → active only)
        || (poster() && onlyChanged(['propertyNo', 'usefulLifeYears', 'residualValue', 'depreciable', 'condition', 'history', 'updatedAt',
          'description', 'specs', 'articleType', 'remarks', 'dvNo', 'photoUrl', 'docUrl', 'unit', 'special', 'acquisition', 'estimatedLife', 'location',
          'cost', 'unitCost', 'dateAcquired', 'accountCode', 'depBaseline', 'priorAdjustment', 'components',
          'revaluations', 'adjustments', 'accountChanges', 'fundChanges', 'fund', 'reactivations', 'status', 'disposal'])
          && (request.resource.data.status == resource.data.status || (resource.data.status == 'disposed' && request.resource.data.status == 'active')))
        // the PAR / ICS (or its AIR) was renumbered: the item's copy of the number follows
        || (issuer() && onlyChanged(['source', 'history', 'updatedAt']) && request.resource.data.source.kind == resource.data.source.kind
          && request.resource.data.source.docId == resource.data.source.docId)
        || isAdmin());
      allow delete: if false;
    }

    // PTR / ITR (transfers), PRS / RRSP (returns) and disposals.
    match /movements/{id} {
      allow read: if viewer();
      allow create: if issuer()
        && request.resource.data.docType in ['ptr', 'itr', 'prs', 'rrsp', 'dsp']
        && validFund(request.resource.data.fund)
        && request.resource.data.status == 'done' && request.resource.data.posting.posted == false;
      allow update: if
        (issuer() && resource.data.needsPosting == true && resource.data.status == 'done' && resource.data.posting.posted == false
          && request.resource.data.status == 'cancelled' && onlyChanged(['status', 'cancel', 'updatedAt']))
        // printed details only (signatories, reason, reference) — the items are untouched
        || (issuer() && resource.data.status == 'done' && onlyChanged(['reason', 'ref', 'typeOther', 'approvedBy', 'issuedBy', 'edited', 'updatedAt']))
        || (poster() && resource.data.needsPosting == true && resource.data.status == 'done' && onlyChanged(['posting', 'updatedAt']));
      allow delete: if false;
    }

    // Posted depreciation, one document per fund and month ("GF_2026-01"). Only the latest is unposted (app rule).
    match /depreciation/{id} {
      allow read: if viewer();
      allow create: if poster() && id == request.resource.data.fund + '_' + request.resource.data.period
        && validFund(request.resource.data.fund) && request.resource.data.period.matches('^[0-9]{4}-[0-9]{2}$')
        // posting although the prior month's Trial Balance doesn't tie out is an administrator's call
        && (!('override' in request.resource.data) || isAdmin());
      allow delete: if poster();
      allow update: if false;
    }

    // Trial Balance per fund and month, for reconciliation.
    match /tbSnapshots/{id} {
      allow read: if viewer();
      allow write: if poster() && id == request.resource.data.fund + '_' + request.resource.data.period && validFund(request.resource.data.fund);
    }

    // ---------------- Construction in Progress (Accounting) ----------------
    match /cipProjects/{id} {
      allow read: if viewer();
      allow create: if poster() && validFund(request.resource.data.fund)
        && request.resource.data.accountCode in ['10710010', '10710020', '10710030'] && request.resource.data.status == 'in_progress';
      // billings, status and details while open; a transferred project is closed for good
      allow update: if poster() && resource.data.status != 'completed'
        && request.resource.data.fund == resource.data.fund
        && request.resource.data.accountCode in ['10710010', '10710020', '10710030']
        && request.resource.data.status in ['in_progress', 'completed'];
      allow delete: if poster() && resource.data.billings.size() == 0;
    }

    // Statements of Work Accomplished: encoded by the GSO or Accounting, matched to a billing by Accounting.
    match /swa/{id} {
      allow read: if viewer();
      allow create: if (issuer() || poster()) && validFund(request.resource.data.fund) && request.resource.data.matched == false;
      allow update: if ((issuer() || poster()) && resource.data.matched == false && request.resource.data.matched == false)
        || (poster() && onlyChanged(['matched', 'matchedProjectId', 'matchedBillingId', 'updatedAt']));
      allow delete: if (issuer() || poster()) && resource.data.matched == false;
    }

    // ---------------- History of Repair ----------------
    // Request (End-User for their own property, or the GSO) → GSO pre-repair inspection → job order recorded → GSO
    // post-repair inspection (+ WMR) → Accounting posts → GSO verifies. "submitted": recorded before the inspections.
    function repairBase() {
      return request.resource.data.endUserUid == resource.data.endUserUid && request.resource.data.assetId == resource.data.assetId
        && request.resource.data.fund == resource.data.fund;
    }
    match /repairs/{id} {
      allow read: if viewer() || (active() && resource.data.endUserUid == request.auth.uid);
      allow create: if active() && request.resource.data.status == 'requested' && validFund(request.resource.data.fund)
        && !request.resource.data.keys().hasAny(['preInspection', 'postInspection', 'posting', 'verifiedBy', 'wmr'])
        && (issuer() || (request.resource.data.endUserUid == request.auth.uid
          && get(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data.custodianUid == request.auth.uid));
      allow update: if
        // the End-User (or GSO) edits the request, or records the job order once approved for repair, and sends it on
        (active() && (resource.data.endUserUid == request.auth.uid || issuer()) && repairBase()
          && resource.data.status in ['requested', 'preinspected', 'repaired', 'submitted', 'returned']
          && ((request.resource.data.status == 'requested' && !resource.data.get('preInspection', {}).get('approved', false))
            || (request.resource.data.status == 'repaired'
              && (resource.data.get('preInspection', {}).get('approved', false) || resource.data.status == 'submitted'
                || (resource.data.status == 'returned' && resource.data.get('jobOrderNo', '') != '' && !resource.data.keys().hasAny(['preInspection'])))))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['preInspection', 'postInspection', 'posting', 'verifiedBy', 'wmr', 'encodedBy', 'createdAt']))
        // the GSO's pre-repair inspection: approve for repair, or return
        || (issuer() && resource.data.status == 'requested' && request.resource.data.status in ['preinspected', 'returned']
          && onlyChanged(['preInspection', 'status', 'gsoRemarks', 'reviewedBy', 'reviewedAt', 'updatedAt']))
        // the GSO's post-repair inspection (+ WMR): for posting, or return
        || (issuer() && resource.data.status in ['repaired', 'submitted'] && request.resource.data.status in ['inspected', 'returned']
          && onlyChanged(['postInspection', 'wmr', 'status', 'gsoRemarks', 'reviewedBy', 'reviewedAt', 'updatedAt']))
        // Accounting posts (or unposts) the repair
        || (poster() && ((resource.data.status == 'inspected' && request.resource.data.status == 'posted')
            || (resource.data.status == 'posted' && request.resource.data.status == 'inspected'))
          && onlyChanged(['posting', 'status', 'updatedAt']))
        // the GSO verifies a posted repair
        || (issuer() && resource.data.status == 'posted' && request.resource.data.status == 'verified'
          && onlyChanged(['status', 'gsoRemarks', 'verifiedBy', 'reviewedBy', 'reviewedAt', 'updatedAt']));
      allow delete: if active() && (resource.data.endUserUid == request.auth.uid || issuer()) && resource.data.status in ['requested', 'returned'];
    }

    // ---------------- clearing the records (Settings → Clear recorded data) ----------------
    // Only the Super Administrator, and only the record collections: users, invites, settings and auditLogs are never cleared.
    match /{coll}/{id} {
      allow delete: if isSuper() && coll in ['airs', 'issuances', 'assets', 'movements', 'repairs', 'cipProjects', 'swa',
        'depreciation', 'tbSnapshots', 'attachments', 'items', 'docNumbers', 'counters'];
    }

    // ---------------- audit trail (append-only) ----------------
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if active() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
